@model IEnumerable<AdminTool.Models.SkillListItemVm>

@foreach (var x in Model)
{
    <tr>
        <td>@x.SkillId</td>
        <td>@x.Name</td>
        <td>
            @if (!string.IsNullOrWhiteSpace(x.IconUrl))
            {
                <img src="@x.IconUrl" alt="icon" style="width:24px;height:24px;object-fit:contain;" />
            }
        </td>

        <td>@x.Type</td>
        <td>@x.ElementId</td>
        <td>@x.TargetingType</td>
        <td>@x.TargetSide</td>
        <td>@x.AoeShape</td>

        <td>@(x.IsActive ? "Active" : "Passive")</td>

        <td>
            @if (x.Tag?.Length > 0)
            {
                @string.Join(", ", x.Tag)
            }
        </td>

        <td class="text-end text-nowrap">
            <a asp-route="Skills_Levels" asp-route-id="@x.SkillId" class="btn btn-sm btn-outline-primary">
                Skill Levels
            </a>
            <a asp-action="Edit" asp-route-id="@x.SkillId" class="btn btn-sm btn-outline-primary">Edit</a>
            <form asp-action="Delete" asp-route-id="@x.SkillId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('삭제할까요?');">
                    Delete
                </button>
            </form>
        </td>
    </tr>
}
