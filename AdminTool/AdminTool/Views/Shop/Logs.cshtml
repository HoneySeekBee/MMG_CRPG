@using AdminTool.Models
@model List<PurchaseLogVm>

@{
    ViewData["Title"] = "Purchase Logs";
    var filter = ViewBag.Filter as PurchaseLogFilterVm ?? new PurchaseLogFilterVm();
    var page = ViewBag.Page;
    int currentPage = page != null ? (int)page.Page : filter.Page;
    int totalPages = page != null ? (int)page.TotalPages : 1;
}

<div class="container py-3">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Purchase Logs</h2>
        <a class="btn btn-outline-secondary ms-auto" href="/admin/shop">← Shops</a>
    </div>

    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <!-- Filter -->
    <form method="get" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label">User ID</label>
                <input type="number" name="userId" class="form-control" value="@filter.UserId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Product ID</label>
                <input type="number" name="shopProductId" class="form-control" value="@filter.ShopProductId" />
            </div>
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="datetime-local" name="from" class="form-control"
                       value="@(filter.From?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="datetime-local" name="to" class="form-control"
                       value="@(filter.To?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a href="/admin/shop/logs" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Paid</th>
                    <th>Currency</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No logs</td></tr>
            }
            else
            {
                foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Id</td>
                        <td>@x.UserId</td>
                        <td>@x.ShopProductId</td>
                        <td>@x.Quantity</td>
                        <td>@x.PricePaid.ToString("N0")</td>
                        <td><code>@x.CurrencyCode</code></td>
                        <td>@x.PurchasedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-2">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="/admin/shop/logs?page=@(currentPage-1)&userId=@filter.UserId&shopProductId=@filter.ShopProductId">Prev</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/admin/shop/logs?page=@i&userId=@filter.UserId&shopProductId=@filter.ShopProductId">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="/admin/shop/logs?page=@(currentPage+1)&userId=@filter.UserId&shopProductId=@filter.ShopProductId">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
